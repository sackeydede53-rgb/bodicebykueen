# Local SQLite (development)
DATABASE_URL="file:./dev.db"

# Turso / libSQL (required on Vercel — local SQLite does not work on serverless)
# Create a free DB at https://turso.tech then paste URL + token here and in Vercel → Settings → Environment Variables
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

AUTH_SECRET="generate-a-long-random-string"
# Use your production URL on Vercel, e.g. https://bodicebykueen.vercel.app
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@bodicebykueen.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Bodice Admin"

PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bodice by Kueen <orders@bodicebykueen.com>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Vercel Blob (required for admin image uploads on Vercel)
# Create via Vercel → Storage → Blob — token is auto-added when you connect the store
BLOB_READ_WRITE_TOKEN=""
